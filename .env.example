# 런던_디스패치 환경변수 예제
# 이 파일을 .env 로 복사하고 값을 채운다. .env 는 git 에 올리지 않는다.
# 모든 키는 server/src/env.ts 에서만 읽는다. 다른 파일의 process.env 는 훅이 차단한다.

# --- 실행 ---
NODE_ENV=development
# Railway 는 PORT 를 주입한다. 로컬 기본 3000
PORT=3000
# debug | info | warn | error
LOG_LEVEL=info

# --- 저장 ---
# SQLite 파일 경로. Railway 는 Volume 마운트 /app/data/london_dispatch.sqlite
DATABASE_PATH=./data/london_dispatch.sqlite

# --- 토큰 (갠홈 등급 연동) ---
# 갠홈 rosebell-chatbot.php 의 토큰 조각과 같은 값. 32자 이상 랜덤. dev 는 아무 문자열
TOKEN_SECRET=
# 쓰기(생성·수정·방 관리) 허용 최소 등급 (그누보드 mb_level). 확정사항 §9-1
TOKEN_MIN_LEVEL=5

# --- AI 제공사 ---
# anthropic | openai | google  (확정사항 §9-4, 미정)
LLM_PROVIDER=
# 제공사 API 키. 로그·응답·화면에 절대 찍지 않는다
LLM_API_KEY=
# 제공사 모델 식별자
LLM_MODEL=
# 제공사 호출 타임아웃(ms). 기본 60000
LLM_TIMEOUT_MS=60000

# --- 임베드·보안 ---
# iframe 허용 출처. 공백 구분. 확정사항 §9-7
ALLOWED_FRAME_ANCESTORS=http://london-gossip.my https://london-gossip.my
# 토큰(mb_id) 단위 쓰기 요청 분당 상한. 확정사항 §9-6
RATE_LIMIT_PER_MIN=20

# --- 생성 규칙 ---
# speak 에 넣는 최근 메시지 수
CONTEXT_MESSAGES=40
# 이 수를 넘으면 오래된 구간을 요약해 장기기억에 합친다
MEMORY_SUMMARY_THRESHOLD=60
